<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!--
      The golden-image suite resolves its baselines through [CallerFilePath] so that a
      re-record rewrites the PNGs in the working tree rather than in the output directory.
      ContinuousIntegrationBuild — which Directory.Build.props turns on for CI — implies
      DeterministicSourcePaths, and that rewrites [CallerFilePath] to "/_/tests/...".

      The failure mode is worse than a broken build. The suite treats a missing baseline as
      "write it and fail", so on a build server it would write a whole fresh set of baselines
      outside the repository, fail once, and then *pass* on any re-run — comparing renders
      against images it had generated itself moments earlier. A green suite checking nothing.

      Determinism is worth having for the assemblies that ship; it is not worth having here.
    -->
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SoftEngine.Core\SoftEngine.Core.csproj" />

    <!-- For the parts of the GPU backend that are decisions rather than drawing — which
         adapter names mean hardware, what a backend request resolves to. Nothing here
         creates an OpenGL context, so the suite still runs on a machine with no display. -->
    <ProjectReference Include="..\..\src\SoftEngine.Gpu\SoftEngine.Gpu.csproj" />
  </ItemGroup>

</Project>